## Contact form (Resend)
#
# Copy to .env.local and fill in values to enable /api/contact email sending.
# If not configured, the API will return "Not configured" and the UI will tell
# the visitor to call instead.

# In Cloudflare, add this as an encrypted Worker secret, never a public variable.
RESEND_API_KEY=

# Where contact emails should be delivered
CONTACT_TO_EMAIL=joakim@ohlssonsmaleri.se

# Sender address on a domain verified in Resend.
# Example after verifying forms.ohlssonsmaleri.se:
# CONTACT_FROM_EMAIL="Jocke Ohlssons Måleri <webb@forms.ohlssonsmaleri.se>"
CONTACT_FROM_EMAIL=

